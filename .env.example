VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URL Supabase cote serveur (peut etre la meme que VITE_SUPABASE_URL)
SUPABASE_URL=https://votre-projet.supabase.co

# Cle service role Supabase (jamais exposee cote client)
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Gmail de l'AS utilise pour envoyer les emails
GMAIL_USER=as.sportive.insa@gmail.com

# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Google Account > Securite > Validation en 2 etapes > Mots de passe des applications
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# URL publique de l'application utilisee dans les liens des emails
# Exemple : https://mon-app.vercel.app
APP_BASE_URL=https://votre-domaine.vercel.app
