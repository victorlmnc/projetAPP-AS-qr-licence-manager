VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé service role Supabase (jamais exposée côté client — uniquement dans Vercel env)
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Gmail de l'AS utilisé pour envoyer les emails
GMAIL_USER=as.sportive.insa@gmail.com
# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Google Account → Sécurité → Validation en 2 étapes → Mots de passe des applications
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
